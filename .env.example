# Port configuration
PORT=5000

# Database connection
MONGODB_URI=mongodb://127.0.0.1:27017/transitops

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_make_it_long_and_secure
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# Optional: Cloudinary config (For vehicle document uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
